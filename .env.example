# ---------------------------------------------------------------------------
# Portal server environment (never expose these values to frontend code)
# ---------------------------------------------------------------------------

# ECHO assistant. Leave enabled; set false to hide the widget entirely.
ECHO_CHAT_ENABLED=true
ECHO_SITE_ID=productivity-portal

# School time zone for "today", "next class" and "due today". The application
# itself stores no time-zone setting: the school record's address is the only
# authoritative signal, and it is in California, so use America/Los_Angeles.
# Defaults to UTC when unset, which shifts days and periods for this school.
ECHO_PORTAL_TIMEZONE=America/Los_Angeles

# ECHO conversation sessions. Set a long random value in production. Without it
# ECHO uses an unguessable per-process key, so sessions do not survive a restart
# or a different serverless instance. SESSION_SECRET is the portal's own cookie
# signing secret and is also accepted as the ECHO fallback.
ECHO_SESSION_SECRET=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# FreeLLMAPI - ECHO's primary conversational provider
# ---------------------------------------------------------------------------
# Keys and endpoints stay server-side. The browser never receives them.
#
# LOCAL DEVELOPMENT: if FREELLMAPI_API_KEY is set and no base URL is given,
# ECHO uses the FreeLLMAPI desktop gateway at http://127.0.0.1:31415/v1.
# The FreeLLMAPI desktop app must be running on the same machine.
#
# PRODUCTION / VERCEL: a loopback URL cannot be reached from Vercel. Provide a
# public HTTPS endpoint (for example an HTTPS tunnel to the gateway or a hosted
# FreeLLMAPI-compatible gateway). HTTP is rejected for non-loopback hosts.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
# "auto:reliable" lets the gateway choose a reliable upstream model; a concrete
# model ID is also accepted.
FREELLMAPI_MODEL=auto:reliable

# Legacy aliases FREELMAPI_* and ECHO_MODEL_* remain supported for existing
# deployments. Prefer the FREELLMAPI_* names above.

# ---------------------------------------------------------------------------
# Optional paid provider - disabled unless explicitly enabled
# ---------------------------------------------------------------------------
# Do not set ECHO_ALLOW_PAID_PROVIDER=true unless you intend to pay OpenAI.
ECHO_ALLOW_PAID_PROVIDER=false
# OPENAI_API_KEY=
# ECHO_OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Optional external ECHO service (advanced)
# ---------------------------------------------------------------------------
# Leave blank to use the built-in /api/echo service. An external service needs
# HTTPS in production and its own provider configuration.
# ECHO_API_URL=https://echo-api.example.com
# ECHO_REQUIRE_EXTERNAL=false

# Spoken replies use the browser's free on-device speechSynthesis by default.
# There is no TTS key or server cost. A replacement can be registered in the
# browser via window.EchoWidgetSpeechProviders; no environment variable needed.
