# Optional server environment settings (works out-of-the-box locally and on Vercel with zero configuration).
# Set ECHO_CHAT_ENABLED=false to hide the ECHO assistant widget.
ECHO_CHAT_ENABLED=true
ECHO_SITE_ID=productivity-portal

# Leave ECHO_API_URL blank to use the built-in portal ECHO v1 service (/api/echo),
# or point it to an external HTTPS ECHO backend:
# ECHO_API_URL=https://echo-api.example.com

# Optional: Set OPENAI_API_KEY on the server to augment built-in ECHO portal answers with live LLM generation.
# OPENAI_API_KEY=
# SESSION_SECRET=
